# Eventide API — environment variables (template).
# Copy to backend/.env for local development (never commit .env). In AWS, values come from
# Secrets Manager (eventide/<env>/*) and the ECS task definition (Terraform). No real secret here.
#
# Generate a key:  uv run python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Core ----------------------------------------------------------------------------
# config.settings.dev (manage.py default) | config.settings.test (pytest) | config.settings.prod
# DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Reverse proxies appending to X-Forwarded-For (0 locally, 1 behind the shared ALB).
NUM_PROXIES=0
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16) ----------------------------------------------------------
# Production: ...?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem
DATABASE_URL=postgres://ev_app:ev_local_dev_only@127.0.0.1:55433/eventide
# Connection pool per gunicorn worker (0 = no pool, persistent connections instead).
DB_POOL_MAX_SIZE=0
# DB_CONN_MAX_AGE=60

# --- Web pages and App Links (contract § 8-9) --------------------------------------------
PUBLIC_WEB_BASE_URL=http://127.0.0.1:8000
PLAY_PACKAGE_NAME=
# SHA-256 fingerprints of the app signing certificate(s), comma-separated (AA:BB:...).
ANDROID_CERT_FINGERPRINTS=
LEGAL_PUBLISHER_NAME=
LEGAL_CONTACT_EMAIL=

# --- Google ------------------------------------------------------------------------------
# false only in development (no Play Store build locally); `check --deploy` warns.
PLAY_INTEGRITY_ENFORCED=false
# PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
# Service account JSON (Play Developer API + Play Integrity), one line.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# OAuth client IDs accepted as audience of Google ID tokens (comma-separated).
GOOGLE_OAUTH_CLIENT_IDS=
# Pub/Sub push subscription of the RTDN: audience and service account of the OIDC token.
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT_EMAIL=

# --- Content (CloudFront signed URLs, contract § 8) -------------------------------------
CONTENT_BASE_URL=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key (multi-line value allowed in quotes).
CLOUDFRONT_PRIVATE_KEY=
CONTENT_URL_TTL_SECONDS=3600

# --- Dashboard and publishing (contract § 13-14) -----------------------------------------
# Administrators' Google addresses (secret, comma-separated). Empty: every sign-in refused.
ADMIN_EMAILS=
# OAuth web client of the « Se connecter avec Google » button (also in GOOGLE_OAUTH_CLIENT_IDS).
GOOGLE_WEB_CLIENT_ID=
# Content bucket (signed POST form to uploads/<uuid>/source, processed files).
CONTENT_BUCKET=
CONTENT_BUCKET_REGION=us-east-1
# Media task (ECS RunTask, cluster default capacity provider, no public IP, one at a time).
# Unset: processing runs in a thread of the API when DEBUG=true, and fails clearly otherwise.
MEDIA_TASK_CLUSTER=
MEDIA_TASK_DEFINITION=
MEDIA_TASK_CONTAINER=media
MEDIA_TASK_SUBNETS=
MEDIA_TASK_SECURITY_GROUPS=
# s3 (default when CONTENT_BUCKET is set) or local:<dir> (development).
MEDIA_STORAGE=
